{
  "name": "bream-church-rota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bream Church Rota and Diary Management System",
  "scripts": {
    "check": "tsc --noEmit && npm run smoke && npm run test:acc && npm run test:gen && npm run test:rec && npm run test:sun && npm run test:ical && npm run test:export && npm run test:draft && npm run test:apply && npm run test:rooms && npm run test:msg",
    "smoke": "esbuild seed/render-smoke.ts --bundle --platform=node --format=esm --outfile=.smoke.mjs --log-level=error && node .smoke.mjs",
    "preview": "node scripts/serve.mjs 8080",
    "cf-typegen": "wrangler types",
    "deploy": "npm run check && wrangler deploy",
    "tail": "wrangler tail",
    "test:gen": "esbuild seed/generator-test.ts --bundle --platform=node --format=esm --outfile=.gentest.mjs --log-level=error && node .gentest.mjs",
    "test:ical": "node seed/verify-ical-tz.cjs && node seed/verify-ical-recurrence.cjs",
    "test:rec": "esbuild seed/recurrence-test.ts --bundle --platform=node --format=esm --outfile=.rec.mjs --log-level=error && node .rec.mjs",
    "test:sun": "esbuild seed/sundays-test.ts --bundle --platform=node --format=esm --outfile=.sun.mjs --log-level=error && node .sun.mjs",
    "test:acc": "esbuild seed/access-test.ts --bundle --platform=node --format=esm --outfile=.acc.mjs --log-level=error && node .acc.mjs",
    "test:export": "esbuild seed/export-test.ts --bundle --platform=node --format=esm --outfile=.exp.mjs --log-level=error && node .exp.mjs",
    "test:draft": "esbuild seed/draft-test.ts --bundle --platform=node --format=esm --outfile=.draft.mjs --log-level=error && node .draft.mjs",
    "test:apply": "esbuild seed/apply-test.ts --bundle --platform=node --format=esm --outfile=.apply.mjs --log-level=error && node --no-warnings=ExperimentalWarning .apply.mjs",
    "test:rooms": "esbuild seed/public-rooms-test.ts --bundle --platform=node --format=esm --outfile=.rooms.mjs --log-level=error && node --no-warnings=ExperimentalWarning .rooms.mjs",
    "test:msg": "esbuild seed/message-test.ts --bundle --platform=node --format=esm --outfile=.msg.mjs --log-level=error && node --no-warnings=ExperimentalWarning .msg.mjs"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.134.0"
  }
}
